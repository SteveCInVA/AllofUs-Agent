flowchart TB
    T["Timer 03:00 UTC"] --> RB["rebuild_and_upload"]
    H["POST /api/refresh<br/>Agent.Admin required"] --> RB
    CLI["build_index.py<br/>optional --public selection"] --> RB
    RB --> LOOP["Next enabled source<br/>sequential registry order"]
    LOOP --> LIVE{"Fetch and normalize"}
    LIVE -- "exception: logged" --> PREV["Query existing source count<br/>leave indexed records untouched"]
    PREV --> CARRY["Positive count: carried<br/>zero count: failed"]
    LIVE -- "success; status live" --> MAP["Validate schema, security, unique IDs and sizes<br/>map complete Search documents"]
    MAP --> OLD["Enumerate existing source IDs"]
    OLD --> UP["Upload batches<br/>at most 1,000 documents and 15 MiB"]
    UP --> ACK{"Every upload acknowledged?"}
    ACK -- "no; skip stale-ID deletion" --> ERR["Fail refresh; partial writes may remain<br/>HTTP 500 or timer logs exception"]
    ACK -- "yes" --> DEL["Delete old IDs absent from response<br/>empty successful response removes all source records"]
    DEL --> DACK{"Every delete acknowledged?"}
    DACK -- "no" --> ERR
    DACK -- "yes" --> REPORT["Collect source count and status"]
    CARRY --> REPORT
    MAP -- "validation error" --> ERR
    OLD -- "Search error" --> ERR
    UP -- "Search error; skip stale-ID deletion" --> ERR
    DEL -- "Search error" --> ERR
    PREV -- "Search error" --> ERR
    REPORT --> MORE{"More sources?"}
    MORE -- "yes" --> LOOP
    MORE -- "no" --> OUT["Summary: records, datasets, sources, seconds<br/>all live: refreshed; otherwise degraded with warnings"]
    NOTE["Synchronous HTTP refresh; no distributed lock<br/>writes are non-atomic and eventually consistent<br/>no Blob caches, manifest, or cache invalidation"] -.-> OUT
